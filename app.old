import pandas as pd
import tkinter as tk
from tkinter import filedialog, messagebox
from leitor_xml import extrair_dados_xml, selecionar_arquivos_xml
from exportar_excel import gerar_planilha_notas


def selecionar_local_salvar():
    """Abre a janela para escolher onde salvar o relatório Excel."""
    root = tk.Tk()
    root.withdraw()
    root.attributes("-topmost", True)

    caminho = filedialog.asksaveasfilename(
        title="Salvar relatório",
        defaultextension=".xlsx",
        filetypes=[
            ("Arquivo Excel", "*.xlsx"),
            ("Todos os arquivos", "*.*")
        ],
        initialfile="Relatorio_Notas_Fiscais.xlsx"
    )

    root.destroy()
    return caminho


def main():
    print("=== INICIANDO PROCESSAMENTO DE XMLs ===")
    
    # 1. Selecionar os arquivos XML
    caminhos_xml = selecionar_arquivos_xml()

    if not caminhos_xml:
        print("Nenhum arquivo XML foi selecionado.")
        return

    # 2. Extrair os dados dos XMLs com tratamento de erros por arquivo
    dados_extraidos = []
    for caminho in caminhos_xml:
        try:
            notas = extrair_dados_xml(caminho)
            dados_extraidos.extend(notas)
        except Exception as e:
            print(f"Erro ao processar o arquivo {caminho}: {e}")

    if not dados_extraidos:
        print("Nenhuma nota fiscal válida foi encontrada nos arquivos selecionados.")
        return

    # 3. Criar DataFrame
    df = pd.DataFrame(dados_extraidos)
    dados_para_excel = df.to_dict(orient="records")

    # 4. Escolher onde salvar
    arquivo_saida = selecionar_local_salvar()

    if not arquivo_saida:
        print("Operação cancelada pelo usuário.")
        return

    # 5. Gerar Planilha Avançada
    try:
        gerar_planilha_notas(dados_para_excel, caminho_saida=arquivo_saida)
        print("\n=== CONCLUÍDO COM SUCESSO! ===")
        print(f"Arquivo salvo em: {arquivo_saida}")
    except PermissionError:
        print("\n[ERRO]: O arquivo Excel está aberto em outro programa. Feche-o e tente novamente.")
    except Exception as e:
        print(f"\n[ERRO] Ocorreu um erro ao gerar a planilha: {e}")


if __name__ == "__main__":
    main()